{
  "name": "twelve-o-clock-homepage",
  "version": "0.0.1",
  "private": true,
  "description": "twelve-o-clock-homepage",
  "author": "Hieu Pham",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "dev": "gatsby develop",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "prod": "gatsby build && gatsby serve",
    "deploy": "gatsby build && cp CNAME public/ && cp robots.txt public/ && gh-pages -d public",
    "release": "standard-version",
    "release-major": "rm -f -- package-lock.json && npm run release -- --release-as major",
    "release-minor": "rm -f -- package-lock.json && npm run release -- --release-as minor",
    "release-patch": "rm -f -- package-lock.json && npm run release -- --release-as patch"
  },
  "dependencies": {
    "@mdi/js": "^7.3.67",
    "@mdi/react": "^1.6.1",
    "autoprefixer": "^10.4.16",
    "gatsby": "^5.12.4",
    "gatsby-plugin-google-gtag": "^5.12.3",
    "gatsby-plugin-manifest": "^5.12.3",
    "gatsby-plugin-postcss": "^6.12.0",
    "gatsby-plugin-sass": "^6.12.3",
    "gatsby-plugin-sitemap": "^6.12.3",
    "gh-pages": "^6.1.0",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.69.5",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.3.3",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "typescript": "^5.1.6"
  }
}
