{
  "name": "twelve-o-clock-homepage",
  "version": "1.1.0",
  "private": true,
  "description": "twelve-o-clock-homepage",
  "author": "Hieu Pham",
  "keywords": [
    "gatsby"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "gatsby develop",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "prod": "gatsby build && gatsby serve",
    "deploy": "gatsby build && cp CNAME public/ && cp robots.txt public/ && gh-pages -d public",
    "release": "standard-version",
    "release-major": "npm run release -- --release-as major",
    "release-minor": "npm run release -- --release-as minor",
    "release-patch": "npm run release -- --release-as patch"
  },
  "dependencies": {
    "@mdi/js": "^7.3.67",
    "@mdi/react": "^1.6.1",
    "autoprefixer": "^10.5.0",
    "gatsby": "^5.16.1",
    "gatsby-plugin-google-gtag": "^5.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-postcss": "^6.16.0",
    "gatsby-plugin-sass": "^6.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gh-pages": "^6.1.0",
    "postcss": "^8.5.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.99.0",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.7.0"
  }
